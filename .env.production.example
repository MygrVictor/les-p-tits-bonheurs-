# ─── Mondial Relay ────────────────────────────────────────────────────────────
# URL de ton endpoint fournisseur (ou proxy interne) pour rechercher les points relais
MONDIAL_RELAY_API_URL=https://api.exemple.com/mondial-relay/points
MONDIAL_RELAY_API_KEY=mr_live_REMPLACER
# Facultatifs selon ton fournisseur / contrat Mondial Relay
MONDIAL_RELAY_ENSEIGNE=
MONDIAL_RELAY_PRIVATE_KEY=
# En production, mettre false dès que l'API réelle est branchée
MONDIAL_RELAY_USE_MOCK=false

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
SITE_URL=https://lespetitsbonheurs.fr
PORT=3000
