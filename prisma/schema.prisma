generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderEventType {
  ORDER_CONFIRMED
  PAYMENT_FAILED
  REFUNDED
  STATUS_UPDATED
  STOCK_RESTORED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  address   String?
  emailVerifiedAt DateTime?
  deletedAt DateTime?
  role      Role     @default(CLIENT)
  orders    Order[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  wishlistItems WishlistItem[]
  reviews       Review[]
  createdAt DateTime @default(now())

  @@index([email])
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id      String    @id @default(cuid())
  name    String
  slug    String    @unique
  logo    String?
  products Product[]

  @@index([slug])
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  // Référence fournisseur (colonne "REF" des fichiers de specs). Sert de
  // clé d'idempotence pour l'import : c'est le seul identifiant stable
  // côté fournisseur (le libellé, lui, change d'une saison à l'autre).
  // Nullable car les produits créés à la main dans l'admin n'en ont pas.
  sku         String?         @unique
  description String
  price       Int
  salePrice   Int?
  images      Json            @default("[]")
  stock       Int             @default(0)
  status      ProductStatus   @default(DRAFT)
  isNew       Boolean         @default(false)
  // Couleur dominante (optionnelle) — id issu de lib/colors.ts (ex.
  // "rose", "dore"…). Sert uniquement à alimenter la catégorie transverse
  // "Acheter par couleur" (/categorie/couleurs), pas de FK : reste un
  // simple texte libre pour éviter une table de référence supplémentaire.
  color       String?
  brandId     String
  brand       Brand           @relation(fields: [brandId], references: [id])
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  stone       Stone?
  supplierSpec ProductSupplierSpec?
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]
  reviews     Review[]
  tags        Json            @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([slug])
  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([color])
  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([name])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  value     String
  stock     Int      @default(0)
  price     Int?

  @@index([productId])
}

model Stone {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  color     String
  virtues   Json     @default("[]")

  @@unique([productId])
}

// Données logistiques issues des fichiers de specs fournisseur (Studio Roof
// et consorts). Isolées dans une table dédiée plutôt que noyées dans
// Product : ce sont des données d'approvisionnement, jamais affichées en
// boutique, et toutes optionnelles selon le fournisseur (les displays, par
// exemple, n'ont ni casepack ni masterpack).
// Les dimensions restent des chaînes : les fichiers mélangent les formats
// ("10x5x20", "10 x 5 x 20 cm", plages…), les normaliser en numérique ferait
// perdre de l'information sans bénéfice réel.
model ProductSupplierSpec {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierRef String
  ean         String?
  origin      String?

  dimensionsCm     String?
  dimensionsInches String?
  weightKg         Float?
  weightOunces     Float?

  packagingDimensionsCm     String?
  packagingDimensionsInches String?

  casepackEan        String?
  casepackQty        Int?
  casepackDimensions String?
  casepackWeightKg   Float?

  masterpackEan          String?
  masterpackQty          Int?
  masterpackDimensions   String?
  masterpackNetWeightKg  Float?
  masterpackGrossWeightKg Float?

  // Onglet + numéro de ligne d'origine : indispensable pour retrouver la
  // source d'une donnée douteuse dans le fichier fournisseur.
  sourceSheet String?
  sourceRow   Int?

  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ean])
  @@index([supplierRef])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  events          OrderEvent[]
  total           Int
  status          OrderStatus @default(PENDING)
  stripePaymentId String?     @unique
  stripeIntentId  String?     @unique
  // Suivi colis, rempli manuellement par l'admin au moment de l'expédition
  // (voir lib/carriers.ts pour la liste des transporteurs + génération du
  // lien de suivi). Texte libre, pas de FK : pas besoin d'une table dédiée
  // pour un simple identifiant transporteur.
  carrier         String?
  trackingNumber  String?
  createdAt       DateTime    @default(now())

  @@index([userId])
  @@index([status])
}

model OrderEvent {
  id            String         @id @default(cuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  type          OrderEventType
  message       String?
  data          Json           @default("{}")
  stripeEventId String?        @unique
  createdAt     DateTime       @default(now())

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  variantId String?
  quantity  Int
  price     Int

  @@index([orderId])
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    Int
  comment   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([userId])
  @@index([approved])
}
